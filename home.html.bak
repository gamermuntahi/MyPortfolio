<!doctype html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>Dev. Muntahi</title>

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css"/>

<style>
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  font-family: "Segoe UI", sans-serif;
}

body {
  background: #000;
  overflow: hidden;
  opacity: 0;
  animation: fadeIn 0.4s ease forwards;
}

@keyframes fadeIn {
  to { opacity: 1; }
}

/* HERO */
.heroArea {
  position: relative;
  width: 100%;
  height: 100vh;
  display: flex;
  justify-content: center;
  align-items: center;
}

/* VIDEO */
.heroVideo {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  z-index: 1;
}

/* OVERLAY */
.heroOverlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(to bottom, rgba(0,0,0,0.4), rgba(0,0,0,0.8));
  z-index: 2;
}

/* CARD */
.heroArea_text {
  position: relative;
  z-index: 3;
  width: 550px;
  max-width: 92%;
  padding: 35px;
  border-radius: 24px;

  background: rgba(255,255,255,0.08);
  backdrop-filter: blur(20px);
  border: 1px solid rgba(255,255,255,0.15);

  text-align: center;
  color: white;

  opacity: 0;
  transform: scale(0.92) translateY(20px);
  animation: cardIn 0.8s ease 0.3s forwards;
}

@keyframes cardIn {
  to {
    opacity: 1;
    transform: scale(1) translateY(0);
  }
}

.heroArea_img {
  width: 110px;
  height: 110px;
  border-radius: 50%;
  margin-bottom: 15px;
  border: 3px solid rgba(255,255,255,0.15);

  opacity: 0;
  transform: scale(0.7);
  animation: imgPop 0.8s ease 0.6s forwards;
}

@keyframes imgPop {
  to { opacity: 1; transform: scale(1); }
}

.heroArea_title {
  font-size: 2rem;
  font-weight: 700;
  background: linear-gradient(90deg, #fff, #3b82f6, #fff);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.heroArea_desc {
  margin-top: 15px;
  opacity: 0.85;
  line-height: 1.6;
}

.heroLocation {
  margin-top: 15px;
  font-size: 12px;
  opacity: 0.8;
}

.status {
  margin-top: 12px;
  color: #4ade80;
  font-size: 0.9rem;
}

/* SOCIALS */
.heroSocials {
  margin-top: 20px;
  display: flex;
  justify-content: center;
  gap: 12px;
}

.heroSocials a {
  width: 48px;
  height: 48px;
  display: flex;
  justify-content: center;
  align-items: center;
  border-radius: 50%;
  text-decoration: none;
  color: white;
  background: rgba(255,255,255,0.08);
  border: 1px solid rgba(255,255,255,0.1);
  transition: 0.3s;
}

.heroSocials a:hover {
  transform: translateY(-5px) scale(1.1);
  background: rgba(139,92,246,0.25);
}

/* ========================= */
/* 🎧 SOUND MIXER (GLASS UI) */
/* ========================= */

.mixer {
  position: fixed;
  top: 50%;
  transform: translateY(-50%);
  width: 80px;
  height: 320px;

  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  padding: 10px;

  background: rgba(255,255,255,0.06);
  backdrop-filter: blur(18px);
  border: 1px solid rgba(255,255,255,0.1);
  border-radius: 18px;

  z-index: 10;
}

.mixer.left { left: 20px; }
.mixer.right { right: 20px; }

.bar {
  width: 4px;
  height: 10px;
  border-radius: 10px;
  background: linear-gradient(to top, #3b82f6, #a855f7, #ec4899);
  transition: 0.05s;
}
</style>
</head>

<body>

<section class="heroArea">

  <!-- VIDEO -->
  <video class="heroVideo" id="bgVideo" autoplay muted loop playsinline>
    <source src="static/video/Background01.mp4" />
  </video>

  <div class="heroOverlay"></div>

  <!-- CARD -->
  <div class="heroArea_text">
    <img src="static/image/font_mc_skin.png" class="heroArea_img"/>

    <h1 class="heroArea_title">Dev. Muntahi</h1>

    <p class="heroArea_desc">
      I don't just write code—I build AI, create games, design graphics, and transform ideas into reality.
    </p>

    <div class="heroLocation">
      <i class="fa-solid fa-location-dot"></i> Dhaka, Bangladesh
    </div>

    <div class="status">● Available for Projects</div>

    <div class="heroSocials">
      <a href="#"><i class="fa-brands fa-discord"></i></a>
      <a href="#"><i class="fa-brands fa-github"></i></a>
      <a href="#"><i class="fa-brands fa-youtube"></i></a>
      <a href="#"><i class="fa-brands fa-steam"></i></a>
      <a href="#"><i class="fa-solid fa-envelope"></i></a>
    </div>
  </div>

</section>

<!-- MIXERS -->
<div class="mixer left" id="leftMixer"></div>
<div class="mixer right" id="rightMixer"></div>

<!-- AUDIO -->
<audio id="bgAudio" loop>
  <source src="static/audio/Background01.mp3" type="audio/mp3">
</audio>

<script>
const audio = document.getElementById("bgAudio");
const video = document.getElementById("bgVideo");

const left = document.getElementById("leftMixer");
const right = document.getElementById("rightMixer");

/* AUDIO ANALYSER */
const ctx = new (window.AudioContext || window.webkitAudioContext)();
const analyser = ctx.createAnalyser();
analyser.fftSize = 64;

const source = ctx.createMediaElementSource(audio);
source.connect(analyser);
analyser.connect(ctx.destination);

const data = new Uint8Array(analyser.frequencyBinCount);

const BAR_COUNT = 20;

/* create bars */
function createBars(el) {
  for (let i = 0; i < BAR_COUNT; i++) {
    const bar = document.createElement("div");
    bar.className = "bar";
    el.appendChild(bar);
  }
}

createBars(left);
createBars(right);

const L = left.children;
const R = right.children;

/* SYNC START */
function start() {
  video.play();
  audio.play();
  ctx.resume();
}

/* autoplay fallback */
window.addEventListener("load", () => {
  start().catch(() => {
    document.body.addEventListener("click", start, { once: true });
  });
});

/* animation */
function animate() {
  requestAnimationFrame(animate);

  analyser.getByteFrequencyData(data);

  for (let i = 0; i < BAR_COUNT; i++) {
    const h = (data[i] / 255) * 300 + 10;

    L[i].style.height = h + "px";
    R[i].style.height = h + "px";
  }
}

animate();
</script>

</body>
</html>